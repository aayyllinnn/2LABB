{% extends 'base.html.twig' %}

{% block title %}Measurement index{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 my-0">Measurement index</h1>

        {% if is_granted('ROLE_MEASUREMENT_NEW') %}
            <a href="{{ path('app_measurement_new') }}" class="btn btn-success">Create new</a>
        {% endif %}
    </div>

    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Id</th>
            <th>Date</th>
            <th>Celsius</th>
            <th>Humidity</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for measurement in measurements %}
            <tr>
                <td>{{ measurement.id }}</td>
                <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                <td>{{ measurement.celsius }}</td>
                <td>{{ measurement.humidity }}</td>
                <td class="text-end">
                    {% if is_granted('ROLE_MEASUREMENT_SHOW') %}
                        <a class="btn btn-sm btn-outline-secondary"
                           href="{{ path('app_measurement_show', {'id': measurement.id}) }}">show</a>
                    {% endif %}

                    {% if is_granted('ROLE_MEASUREMENT_EDIT') %}
                        <a class="btn btn-sm btn-primary"
                           href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a>
                    {% endif %}


                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
