{% extends 'base.html.twig' %}

{% block title %}Location index{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 my-0">Location index</h1>

        {% if is_granted('ROLE_LOCATION_NEW') %}
            <a href="{{ path('app_location_new') }}" class="btn btn-success">Create new</a>
        {% endif %}
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>Id</th>
                <th>City</th>
                <th>Country</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for location in locations %}
                <tr>
                    <td>{{ location.id }}</td>
                    <td>{{ location.city }}</td>
                    <td>{{ location.country }}</td>
                    <td>{{ location.latitude }}</td>
                    <td>{{ location.longitude }}</td>
                    <td class="text-end">

                        {% if is_granted('ROLE_LOCATION_SHOW') %}
                            <a class="btn btn-sm btn-outline-secondary"
                               href="{{ path('app_location_show', {'id': location.id}) }}">show</a>
                        {% endif %}

                        {% if is_granted('ROLE_LOCATION_EDIT') %}
                            <a class="btn btn-sm btn-primary"
                               href="{{ path('app_location_edit', {'id': location.id}) }}">edit</a>
                        {% endif %}


                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">No records</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
