{% extends 'base.html.twig' %}

{% block title %}Edit Location{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 my-0">Edit Location</h1>
    </div>

    <div class="card shadow-sm p-4">
        {{ form_errors(form) }}

        {{ include('location/_form.html.twig', { form: form, button_label: 'Update' }) }}
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a class="btn btn-link" href="{{ path('app_location_index') }}">← Back to list</a>
        {{ include('location/_delete_form.html.twig') }}
    </div>
{% endblock %}
