{% extends 'base.html.twig' %}

{% block title %}Create Location{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 my-0">Create new Location</h1>
    </div>

    <div class="card shadow-sm p-4">

        {{ form_errors(form) }}


        {{ include('location/_form.html.twig', { form: form, button_label: 'Create' }) }}
    </div>

    <div class="mt-3">
        <a class="btn btn-link" href="{{ path('app_location_index') }}">← Back to list</a>
    </div>
{% endblock %}
