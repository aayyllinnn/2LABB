{% extends 'base.html.twig' %}

{% block title %}Location {{ location.id }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Location details</h1>

    <div class="card shadow-sm p-4 mb-3">
        <dl class="row mb-0">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">{{ location.id }}</dd>

            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">{{ location.city }}</dd>

            <dt class="col-sm-3">Country</dt>
            <dd class="col-sm-9">{{ location.country }}</dd>

            <dt class="col-sm-3">Latitude</dt>
            <dd class="col-sm-9">{{ location.latitude }}</dd>

            <dt class="col-sm-3">Longitude</dt>
            <dd class="col-sm-9">{{ location.longitude }}</dd>
        </dl>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <a class="btn btn-link" href="{{ path('app_location_index') }}">← Back to list</a>
        <div>
            <a class="btn btn-primary me-2" href="{{ path('app_location_edit', {'id': location.id}) }}">Edit</a>
            {{ include('location/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
