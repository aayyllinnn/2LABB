{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Weather App{% endblock %}</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    <style>
        body {
            background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=52087");
            background-repeat: repeat;
            font-family: "Segoe UI", Arial, sans-serif;
        }
    </style>
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-light bg-light mb-4 shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_location_index') }}">Weather App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="nav" class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link{% if app.request.get('_route') starts with 'app_location' %} active{% endif %}"
                       href="{{ path('app_location_index') }}">Locations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link{% if app.request.get('_route') starts with 'app_measurement' %} active{% endif %}"
                       href="{{ path('app_measurement_index') }}">Measurements</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container mb-5">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
